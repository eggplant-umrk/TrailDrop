# Backend-only Supabase project settings. Never expose this key to a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Secret required by the staff-only QR verification endpoint.
STAFF_API_TOKEN=replace-with-a-long-random-value

# Backend-only key used by the route analysis endpoint.
GOOGLE_MAPS_API_KEY=

# Shared key the frontend sends as X-Client-Key to call /routes/analyze.
# This is embedded in the browser bundle (VITE_ROUTE_ANALYSIS_CLIENT_KEY) and is
# not a secret by itself; it exists to block anonymous scanners/curl hitting the
# endpoint directly and is paired with per-IP rate limiting below.
ROUTE_ANALYSIS_CLIENT_KEY=replace-with-a-long-random-value
