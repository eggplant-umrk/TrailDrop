# Backend-only Supabase project settings. Never expose this key to a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Secret required by the staff-only QR verification endpoint.
STAFF_API_TOKEN=replace-with-a-long-random-value

# Backend-only key used by the route analysis endpoint.
GOOGLE_MAPS_API_KEY=

# Shared key the frontend sends as X-Client-Key to call /routes/analyze.
# This is embedded in the browser bundle (VITE_ROUTE_ANALYSIS_CLIENT_KEY) and is
# not a secret by itself; it exists to block anonymous scanners/curl hitting the
# endpoint directly and is paired with per-IP rate limiting below.
ROUTE_ANALYSIS_CLIENT_KEY=replace-with-a-long-random-value

# How POST /routes/analyze picks the pickup location.
# - fixed (default / rollback): force the route through the fixed Hichiso
#   point, exactly as before. Does not read public.pickup_locations.
# - route: use the user's actual route (one Google Routes API call) and offer
#   the active rows of public.pickup_locations within
#   PICKUP_MAX_DISTANCE_METERS of it. Only switch to route after the real
#   coordinates have been seeded into public.pickup_locations.
PICKUP_SELECTION_MODE=fixed
# Maximum distance (meters) between the route and a pickup location for it to
# be offered as a candidate in route mode.
PICKUP_MAX_DISTANCE_METERS=3000

# Comma-separated IPs of reverse proxies/load balancers that this Backend is
# deployed behind, if any. When request.client.host matches one of these,
# the rightmost X-Forwarded-For value is trusted as the real client IP for
# rate limiting (route analysis + staff auth). Leave empty if the Backend is
# reachable directly (no proxy) -- request.client.host is used as-is, which
# is the safe default. Never set this to a wildcard or an untrusted IP: any
# client whose direct connection matches a listed IP can spoof its own
# X-Forwarded-For and evade rate limiting.
#
# IMPORTANT (single-hop assumption): this only supports exactly one trusted
# reverse proxy sitting directly in front of the Backend -- i.e. every IP
# listed here must be a proxy that itself connects directly to the Backend
# process, not one further upstream in a multi-hop chain (e.g. CDN -> load
# balancer -> app server, where only the load balancer's IP would appear as
# request.client.host). If your deployment has more than one hop between the
# public internet and this Backend, do not just add every hop's IP here --
# multi-hop X-Forwarded-For chains are not validated by this logic and doing
# so would let a client spoof the IP any hop other than the last one would
# have appended. Terminate/normalize X-Forwarded-For at your edge (e.g. have
# your CDN/load balancer overwrite it, not append to a client-supplied one)
# before it reaches the single proxy listed here, or extend resolve_client_ip
# in main.py to validate the full chain instead.
TRUSTED_PROXY_IPS=
